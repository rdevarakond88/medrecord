{
  "expo": {
    "name": "MedRecord",
    "slug": "medrecord",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "medrecord",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.medrecord.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "MedRecord uses the camera to scan patient documents.",
        "NSMicrophoneUsageDescription": "Microphone access is required for camera use.",
        "NSPhotoLibraryUsageDescription": "MedRecord accesses photos to attach scanned documents.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.medrecord.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A6DB5"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-camera",
      "./plugins/withSslPinning"
    ],
    "extra": {
      "eas": {
        "projectId": "6de7657a-5d63-4727-8c52-917cf6ba301c"
      }
    },
    "owner": "rdevarakonda88"
  }
}
