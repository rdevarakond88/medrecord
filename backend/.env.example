# Copy this file to .env and fill in values. Never commit .env to git.

# PostgreSQL connection string — provided by Render automatically
DATABASE_URL="postgresql://user:password@host:5432/medrecord"

# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET="replace-with-a-long-random-string"

# Test mode — set to "true" to allow OTP bypass code 000000
# Also logs OTP codes to console instead of sending SMS
TEST_OTP_BYPASS="true"

# Port — Render sets this automatically, leave as 3000 for local dev
PORT=3000

# Node environment
NODE_ENV="development"
